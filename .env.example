# Copy to .env and fill in. Never commit .env.
# Optional: without a key the app still works, it just hides substitution suggestions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Default is a local SQLite file. Point at Postgres when deploying.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/budget
# Signs the login cookie. Use a long random string on Render. Empty means a random key per start.
SESSION_SECRET=
# Set to 1 on Render, where the site is HTTPS. Leave empty on your own computer.
COOKIE_SECURE=
