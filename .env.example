# Copy to .env and fill in. Never commit .env.
# Optional: without a key the app still works, it just hides substitution suggestions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Default is a local SQLite file. Point at Postgres when deploying.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/budget
